{
  "schemaVersion": "2.0",
  "sourcesStrategy": "stacked-on-home",
  "note": "Agent-only Notion IA: one Home page with inline catalog DBs under section headers only (도메인/기획/개발). No per-catalog headings, no child pages, no sidebar.",
  "homeStack": {
    "required": true,
    "forbidCatalogHeadings": true,
    "sections": [
      {
        "id": "domain",
        "title": "도메인",
        "databases": ["dbs.glossary", "dbs.models", "dbs.policies"]
      },
      {
        "id": "planning",
        "title": "기획",
        "databases": ["dbs.prds", "dbs.stories"]
      },
      {
        "id": "development",
        "title": "개발",
        "databases": ["dbs.data-model", "dbs.system-model", "dbs.plans", "dbs.adrs"]
      }
    ]
  },
  "objects": [
    {
      "key": "pages.home",
      "kind": "page",
      "title": "Home",
      "parent": "root",
      "role": "home",
      "suppliedAsRoot": true,
      "localPath": "index",
      "metaRole": "home"
    },
    {
      "key": "dbs.glossary",
      "kind": "database",
      "title": "Glossary",
      "parent": "pages.home",
      "inline": true,
      "schema": "glossary",
      "catalogId": "glossary",
      "catalogLabel": "Glossary",
      "documentKinds": ["term"],
      "writeTarget": "database-row",
      "localPath": "domain/glossary",
      "indexUrl": "/docs/domain/glossary"
    },
    {
      "key": "dbs.models",
      "kind": "database",
      "title": "Models",
      "parent": "pages.home",
      "inline": true,
      "schema": "models",
      "catalogId": "models",
      "catalogLabel": "Domain models",
      "documentKinds": ["model"],
      "writeTarget": "database-row",
      "localPath": "domain/models",
      "indexUrl": "/docs/domain/models"
    },
    {
      "key": "dbs.policies",
      "kind": "database",
      "title": "Policies",
      "parent": "pages.home",
      "inline": true,
      "schema": "policies",
      "catalogId": "policies",
      "catalogLabel": "Domain policies",
      "documentKinds": ["policy"],
      "writeTarget": "database-row",
      "localPath": "domain/policies",
      "indexUrl": "/docs/domain/policies"
    },
    {
      "key": "dbs.prds",
      "kind": "database",
      "title": "PRDs",
