    {
      "key": "dbs.stories",
      "kind": "database",
      "title": "Stories",
      "parent": "pages.home",
      "inline": true,
      "schema": "stories",
      "catalogId": "stories",
      "catalogLabel": "User stories",
      "documentKinds": ["story"],
      "writeTarget": "database-row",
      "localPath": "planning/stories",
      "indexUrl": "/docs/planning/stories"
    },
    {
      "key": "dbs.data-model",
      "kind": "database",
      "title": "Data model",
      "parent": "pages.home",
