  "kindToDatabase": {
    "prd": "dbs.prds",
    "story": "dbs.stories",
    "plan": "dbs.plans",
    "adr": "dbs.adrs",
    "spec": "dbs.data-model",
    "term": "dbs.glossary",
    "model": "dbs.models",
    "policy": "dbs.policies"
  },
  "nav": {
    "topLevel": ["pages.home"],
    "nested": {}
  }
